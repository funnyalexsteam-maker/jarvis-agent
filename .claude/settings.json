{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(//**)",
      "Write(//**)",
      "Edit(//**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f /*)",
      "Bash(sudo rm:*)",
      "Bash(sudo rm -rf:*)",
      "Bash(sudo dd:*)",
      "Bash(dd if=:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(kill -9:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout .:*)",
      "Bash(git restore .:*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*TRUNCATE*)",
      "Bash(*DELETE FROM*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Write(//**/.env)",
      "Write(//**/.env.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Bash(cat /**/.env)",
      "Bash(cat /**/.env.*)",
      "Bash(systemctl stop:*)",
      "Bash(systemctl disable:*)",
      "Bash(docker system prune:*)",
      "Bash(npm publish:*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/tmp",
      "/home/agent/projects"
    ]
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "superdesign@claude-plugins-official": true,
    "carbone-skill@claude-plugins-official": true,
    "handoff-engineering@claude-code-skills": true,
    "security-guidance@claude-code-skills": true,
    "agent-launcher-skills@claude-code-skills": true,
    "video-content-strategist@claude-code-skills": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true
  },
"hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start-memory.mjs"
          }
        ]
      }
    ]
  }
}
